{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenttoolbox-retry-gate",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "PAYMENTS_MODE": "dev", "PUBLIC_ORIGIN": "http://127.0.0.1:8787" },
  "d1_databases": [{ "binding": "DB", "database_name": "agenttoolbox-retry-gate-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "CLIENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "SERVICE_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ]
}
